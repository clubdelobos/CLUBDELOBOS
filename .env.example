# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Service role key — SERVER-ONLY. Never import this in a "use client" file or
# send it to the browser. Used for: creating worker/admin accounts, seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js 16: a stable key so encrypted Server Action closures keep working
# across deployments/serverless instances. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Email — "nueva reserva" notification to the admin (src/lib/email/*).
# Provision Resend from the Vercel Marketplace: `vercel integration add resend`
# (this sets RESEND_API_KEY automatically). Verify the site's domain in Resend
# and add its SPF/DKIM/DMARC records to Cloudflare DNS.
# EMAIL_FROM must be a verified sender on that domain.
# Both optional — if unset, bookings still save; the email is just skipped.
# The recipient address is set in the admin panel (Ajustes → Contacto).
RESEND_API_KEY=
EMAIL_FROM="Club de Lobos <reservas@tu-dominio>"

# Shared secret for the daily Supabase keep-alive cron (see vercel.json →
# /api/cron/keep-alive). Set the SAME value in the Vercel project's env vars;
# Vercel Cron then sends it as `Authorization: Bearer <value>` and any other
# caller is rejected. Optional — the route also works without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
